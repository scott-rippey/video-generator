# Copy to .env and fill in. .env is gitignored; never commit real values.

# ElevenLabs: voiceover + music. Required when Voice or Music is on (ElevenLabs dashboard > Profile + API Keys).
ELEVENLABS_API_KEY=

# Modal: optional, not wired into the pipeline yet. Leave empty unless you set up Modal (modal token new).
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Higgsfield needs no key here: the CLI keeps its own auth (higgsfield auth login).
# HeyGen needs no key here: the remote MCP server signs in through the browser (/mcp).
